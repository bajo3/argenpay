# ── Supabase ──────────────────────────────────────────────
# Local: se obtienen con `npx supabase status` luego de `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca exponer en el cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (en producción debe ser https).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Pagos ─────────────────────────────────────────────────
# simulado    → proveedor de prueba (no mueve dinero). Valor por defecto.
# mercadopago → integración real, BLOQUEADA salvo que se cumplan todas las condiciones de abajo.
PAYMENTS_PROVIDER=simulado

# Poner en true solo con autorización expresa del titular de Argenpay.
PAYMENTS_REAL_CHARGES_AUTHORIZED=false
# Poner en true solo con confirmación ESCRITA del proveedor de que se puede cobrar el total,
# esperar la resolución de la orden y recién entonces liquidar al vendedor (ver docs/decision-pagos.md).
PAYMENTS_HOLD_AND_PAYOUT_VERIFIED=false

# Mercado Pago (solo si PAYMENTS_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Tareas programadas ────────────────────────────────────
# Vercel Cron envía "Authorization: Bearer <CRON_SECRET>" a /api/cron/mantenimiento.
CRON_SECRET=

# ── Pago manual (transferencia / QR / Binance / cripto) ────────────────
# PAYMENTS_PROVIDER=manual habilita el circuito manual: el comprador transfiere a tus datos de cobro,
# avisa con el TXID/comprobante y un administrador confirma. Requiere PAYMENTS_REAL_CHARGES_AUTHORIZED=true.
# Los datos de cobro se cargan desde /admin (hasta entonces son GENÉRICOS y se muestra "no transferir").
#
# Avisos al titular cuando un comprador informa un pago (todos opcionales, sin costo):
# · Telegram: crear un bot con @BotFather y averiguar tu chat id (escribile al bot y abrí /getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# · ntfy.sh (notificación push al celular, sin cuenta): instalá la app ntfy, suscribite a un tema difícil de adivinar.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# ── Detector de ingresos en Binance (alarma cuando entra dinero) ──
# API key de SOLO LECTURA (Binance → Gestión de API → sin permisos de trading ni retiro).
# La revisión corre cada minuto (pg_cron en Supabase llama a /api/ingresos/revisar con CRON_SECRET).
BINANCE_API_KEY=
BINANCE_API_SECRET=
